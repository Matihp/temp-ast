---
import Layout from '../layouts/Layout.astro';
import NotesApp from '../components/VoiceNotes/NotesApp';
---

<Layout
  title="Notas de Voz AI"
  description="Graba notas de voz y organiza tus tareas con Inteligencia Artificial."
  locale="es"
>
  <div class="max-w-6xl mx-auto flex flex-col gap-8 h-full min-h-[80vh] px-4">
    <header class="text-center py-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
        Notas de Voz <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">AI</span>
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Dicta tus pensamientos y deja que la Inteligencia Artificial organice mágicamente todo en tareas, ideas y recordatorios.
      </p>
    </header>

    <main class="flex-grow pb-12 w-full">
      <NotesApp client:load />
    </main>
  </div>
</Layout>

<style is:global>
  /* Custom scrollbar para las listas largas de notas */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 20px;
  }
  .dark .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #475569;
  }
</style>
